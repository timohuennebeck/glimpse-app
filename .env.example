# Copy to .env and fill in from your Supabase project settings (API section).
# Both are safe to ship in the client bundle: the anon key is protected by RLS.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used only by supabase/seed and local tooling. Never expose in the app bundle.
SUPABASE_SERVICE_ROLE_KEY=
