# Copy to .env and fill in from your Supabase project: Settings → API Keys.
#
# Supabase replaced the JWT-shaped `anon` / `service_role` keys with
# `sb_publishable_…` / `sb_secret_…` keys (see
# https://supabase.com/docs/guides/getting-started/api-keys). The legacy keys are
# being retired; use only the new ones here.
#
# Both values below are safe to ship in the client bundle: the publishable key
# maps to the `anon` role and every table is protected by RLS.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-side only (the blur Edge Function, seeding, local tooling). Nothing in
# the app bundle reads this; never prefix it with EXPO_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
